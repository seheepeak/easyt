# easyt's settings: copy this file to ~/.easyt/.env and fill in what you use.
# A line left commented out takes the default it describes.

# Where the LLM calls run: claude-code (your Claude subscription, through a logged-in `claude`),
# codex (your ChatGPT subscription, through a logged-in `codex`), or a pydantic-ai provider:model
# name such as anthropic:claude-opus-5-5. The default is claude-code.
# LLM_BACKEND=claude-code

# API keys, needed only when LLM_BACKEND names their provider
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# How many model calls punctuation, translation, line breaking and term extraction each run at once
# LLM_CONCURRENCY=4

# Letters and digits a subtitle line holds: 20 fits Korean, Japanese and Chinese, and an alphabet
# such as English takes about 36
# MAX_LINE_LEN=20

# The Telegram bot: its token from @BotFather, and the one chat it answers and sends results to.
# aterm and transcript send their files to this chat too.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Drive upload, skipped unless both are set: the OAuth client JSON, relative to ~/.easyt
# (then run `easyt auth`), and the ID of the folder results go to
# GOOGLE_OAUTH_CREDENTIALS_FILE=.credentials/client_secret.json
# GOOGLE_DRIVE_FOLDER_ID=
